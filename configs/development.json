{
  "runtime_mode": "development",
  "camera": {
    "camera_id": "sim-camera",
    "calibration_id": "sim-camera-calibration",
    "mounting": "fixed"
  },
  "components": {
    "vision": "simulated-camera",
    "plugins": {
      "perception": "deterministic-perception",
      "planners": [
        "demonstration-planner"
      ],
      "observers": [
        "audit"
      ],
      "preview": [
        "visual-pose-analysis"
      ]
    }
  },
  "camera_parameters": {
    "pixel_format": "RGB8"
  },
  "targets": [
    {
      "name": "sim-primary",
      "role": "primary",
      "robot_adapter": "simulated-robot",
      "gripper_adapter": "simulated-gripper"
    },
    {
      "name": "sim-mirror",
      "role": "mirror",
      "robot_adapter": "simulated-robot",
      "gripper_adapter": "simulated-gripper"
    }
  ],
  "safety": {
    "minimum_perception_confidence": 0.7,
    "maximum_perception_age_seconds": 2.0
  },
  "web": {
    "bind_host": "0.0.0.0",
    "port": 8000,
    "frontend_dist_dir": "src/web/dist",
    "stream_fps": 10,
    "jpeg_quality": 80,
    "capture_retry_seconds": 1.0,
    "camera_controls_enabled": true,
    "gripper_controls_enabled": false,
    "plugin_reload_enabled": false
  }
}
